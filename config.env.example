# Copy this to config.env and fill it in. config.env is gitignored; this file
# is not, so never put a real token here.
#
#   cp config.env.example config.env && chmod 600 config.env
#
# Anything set here can be overridden for one run by exporting it in the shell.

# From @BotFather, after /newbot. Without it an alert can be set but never sent.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# The group's chat id, which is negative for a group and starts -100 for a
# supergroup. This is also the only chat whose bot commands are answered. Add the bot to the group first, post a message, then read the id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# Only ever displayed, in the alert window and at startup. Cosmetic.
TELEGRAM_GROUP_NAME=Aave Loop Alerts
