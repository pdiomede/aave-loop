# Copy to config.env and fill it in. config.env is gitignored; this file is
# not, so never put a real token here.
#
#   cp config.env.example config.env && chmod 600 config.env
#
# Read at startup. An exported variable overrides it for one run, and
# MYAAVE_CONFIG=/path points the app at a file kept elsewhere.

# From @BotFather, after /newbot. Without it a goal can be set but never sent.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Where alerts go and bot commands are answered.
#
# Your own user id (positive, from @userinfobot) for your private chat with the
# bot; send it /start first. Telegram's Menu button appears only there.
#
# Or a group's id (negative, -100... for a supergroup) if others should see the
# alerts. Making the bot an admin can turn a group into a supergroup and change
# its id; the log prints the id of any chat the bot ignores.
TELEGRAM_CHAT_ID=123456789

# Shown in the alert window, the startup log and the test message.
TELEGRAM_CHAT_NAME=Aave Loop

# Optional. With a group above, your own user id: the bot then answers your
# commands in your private chat too, Menu button included. Alerts still go to
# the group alone.
# TELEGRAM_OWNER_ID=123456789
