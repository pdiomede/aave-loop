# Copy this to config.env and fill it in. config.env is gitignored; this file
# is not, so never put a real token here.
#
#   cp config.env.example config.env && chmod 600 config.env
#
# Anything set here can be overridden for one run by exporting it in the shell.

# From @BotFather, after /newbot. Without it an alert can be set but never sent.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Where alerts go, and the only chat whose bot commands are answered.
#
# Your own user id, a positive number, sends everything to your private chat
# with the bot. That is the whole setup if you are the only one reading it, and
# it is the only arrangement that gets Telegram's menu button, which is drawn in
# private chats and nowhere else. Send /start to the bot first: a bot cannot
# open a conversation with someone who has never messaged it.
#
# A group's id instead, if other people should see the alerts. Negative, and
# beginning -100 for a supergroup. Mind that one: Telegram rewrites a group's id
# when it is upgraded to a supergroup, which adding a bot as an administrator is
# enough to trigger, and the old id then matches nothing.
#
# Either way, message @userinfobot for your own id, or read either id out of the
# log: the app prints the id of any chat it ignores.
TELEGRAM_CHAT_ID=123456789

# Only ever displayed, in the alert window and at startup. Cosmetic.
# TELEGRAM_GROUP_NAME is the old name for this and is still read.
TELEGRAM_CHAT_NAME=Aave Loop

# Optional, and off unless you set it. Your own user id, which lets the bot
# answer your commands in a private chat as well as in the chat above. Only
# worth setting when TELEGRAM_CHAT_ID is a group; if it is already you, this is
# the same number and does nothing. Alerts are unaffected either way.
# TELEGRAM_OWNER_ID=123456789
